MONGODB_URI=mongodb://localhost:27017/youtube-clone

# Comma-separated list of origins allowed to call the API (the frontend runs on a
# different origin in dev - Vite's default port). Set to the real frontend origin(s) in AWS.
CORS_ORIGIN=http://localhost:5173

AWS_REGION=us-east-1
# S3_ENDPOINT is only set for local dev (points at the docker-compose MinIO service).
# Leave it unset in AWS so the SDK talks to real S3 and uses the ECS task's IAM role.
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT overrides the host used for presigned playback URLs handed to the
# browser. Only needed when S3_ENDPOINT isn't browser-reachable (e.g. the docker-compose
# backend service uses the container hostname `minio`); defaults to S3_ENDPOINT otherwise.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=videos

# JWT_SECRET is required (no default) - generate a real random value for every environment.
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN_SECONDS=86400
